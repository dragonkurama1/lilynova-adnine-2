# ─── Google Apps Script ─────────────────────────────────────
# URL de déploiement de ton Google Apps Script (Web App)
# Récupérer dans : Apps Script → Déployer → Gérer les déploiements
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXXXXXXXXXXXX/exec

# ─── Admin ───────────────────────────────────────────────────
# Mot de passe pour accéder à l'interface admin
ADMIN_PASSWORD=ton_mot_de_passe_secret
