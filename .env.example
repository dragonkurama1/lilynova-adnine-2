# ─── Supabase ────────────────────────────────────────────────
# Récupérer dans : Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ton_anon_key
# Clé secrète — accès complet, contourne RLS. NE JAMAIS exposer côté client.
SUPABASE_SERVICE_ROLE_KEY=ton_service_role_key
# Bucket Supabase Storage utilisé pour les photos produits/catalogues
SUPABASE_STORAGE_BUCKET=product-images

# ─── Admin ───────────────────────────────────────────────────
# Mot de passe pour accéder à l'interface admin
ADMIN_PASSWORD=ton_mot_de_passe_secret
